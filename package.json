{
  "name": "loung-work",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/api-client"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev -w @loung/web",
    "build": "npm run build -w @loung/web",
    "start": "npm run start -w @loung/web",
    "lint": "npm run lint -w @loung/web",
    "typecheck": "npm run typecheck -w @loung/web",
    "test": "node --test packages/api-client/test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
